<section class="totm-target-dialog">
  <p class="totm-target-dialog__hint">{{hint}}</p>

  <div class="totm-target-dialog__list">
    {{#each groups as |group|}}
      <section class="totm-target-group totm-target-group--{{group.key}}">
        <h4 class="totm-target-group__heading">{{group.label}}</h4>

        <ol class="totm-target-group__list">
          {{#each group.targets as |target|}}
            <li class="totm-target-dialog__row">
              <button
                type="button"
                class="totm-target-btn{{#if target.selected}} totm-target-btn--selected{{/if}}{{#if target.isDefeated}} totm-target-btn--defeated{{/if}}{{#if target.outOfRange}} totm-target-btn--out-of-range{{/if}}{{#if target.rowStatic}} totm-target-btn--static{{/if}}"
                data-dhth="{{target.rowAction}}"
                data-token-id="{{target.id}}"
                {{#if target.disabled}}disabled{{/if}}
                {{!-- Survey rows: inert, but never `disabled` — that would grey
                     out the list this window exists to show. `aria-disabled`
                     says so without the styling, and -1 keeps them out of the
                     tab order so the only stop is the Close button. --}}
                {{#if target.rowStatic}}aria-disabled="true" tabindex="-1"{{/if}}
              >
                <img class="totm-target-btn__portrait" src="{{target.img}}" alt="" />

                <span class="totm-target-btn__label">
                  <span class="totm-target-btn__name">{{target.name}}</span>

                  <span class="totm-target-btn__tags">
                    {{#if target.hasRange}}
                      {{!-- style carries the whole declaration or nothing at all;
                           see rangeStyle in target-picker-app.ts. --}}
                      <span
                        class="totm-target-btn__range"
                        style="{{target.rangeStyle}}"
                        title="{{target.rangeTitle}}"
                      >{{target.rangeLabel}}</span>
                    {{/if}}
                    {{#if target.isDefeated}}
                      <span class="totm-target-btn__defeated">{{target.defeatedLabel}}</span>
                    {{/if}}
                    {{#if target.outOfRange}}
                      <span class="totm-target-btn__out-of-range">{{localize "DHTH.Picker.OutOfRange"}}</span>
                    {{/if}}
                    {{#if target.hasConditions}}
                      {{#each target.conditions as |condition|}}
                        <img
                          class="totm-target-btn__condition"
                          src="{{condition.img}}"
                          alt="{{condition.name}}"
                          title="{{condition.name}}"
                        />
                      {{/each}}
                    {{/if}}
                  </span>
                </span>

                <span class="totm-target-btn__stats">
                  {{#if target.hasDifficulty}}
                    <span class="totm-target-btn__stat totm-target-btn__stat--difficulty">
                      <span class="totm-target-btn__stat-label">{{localize "DHTH.Picker.Difficulty"}}</span>
                      <span class="totm-target-btn__stat-value">{{target.difficulty}}</span>
                    </span>
                  {{/if}}
                  {{#if target.hasEvasion}}
                    <span class="totm-target-btn__stat totm-target-btn__stat--evasion">
                      <span class="totm-target-btn__stat-label">{{localize "DHTH.Picker.Evasion"}}</span>
                      <span class="totm-target-btn__stat-value">{{target.evasion}}</span>
                    </span>
                  {{/if}}
                </span>
              </button>
            </li>
          {{/each}}
        </ol>
      </section>
    {{/each}}
  </div>

  {{#if canPick}}
    <button
      type="button"
      class="totm-target-btn totm-target-btn--no-target"
      data-dhth="no-target"
    >
      <span class="totm-target-btn__no-target-icon"><i class="fa-solid fa-ban"></i></span>
      <span class="totm-target-btn__name">{{localize "DHTH.Picker.NoTarget"}}</span>
    </button>
  {{/if}}

  <footer class="totm-target-dialog__footer">
    {{#if multi}}
      <span class="totm-target-dialog__count">{{countLabel}}</span>
    {{/if}}
    <div class="totm-target-dialog__actions">
      <button type="button" class="totm-target-dialog__btn" data-dhth="cancel">
        {{dismissLabel}}
      </button>
      {{#if multi}}
        <button
          type="button"
          class="totm-target-dialog__btn totm-target-dialog__btn--primary"
          data-dhth="confirm"
          {{#unless canConfirm}}disabled{{/unless}}
        >
          {{localize "DHTH.Picker.Confirm"}}
        </button>
      {{/if}}
    </div>
  </footer>
</section>
